{
  "name": "git-saohua",
  "version": "0.1.0",
  "description": "JavaScript/TypeScript SDK for Git Saohua API — 让每一次 git commit 都带着灵魂",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "test": "npm run build && node test.js",
    "test:watch": "npm run build && node --test --watch test.js",
    "lint": "tsc --noEmit",
    "prepublishOnly": "npm run test"
  },
  "keywords": [
    "git",
    "commit",
    "saohua",
    "funny",
    "sdk",
    "typescript"
  ],
  "license": "MIT",
  "authors": [
    {
      "name": "justlovemaki",
      "email": "justlovemaki@users.noreply.github.com"
    }
  ],
  "homepage": "https://github.com/justlovemaki/git-commit-sao-hua",
  "repository": {
    "type": "git",
    "url": "https://github.com/justlovemaki/git-commit-sao-hua"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "typescript": "^5.3.0"
  }
}