# Git Saohua API 环境变量配置示例

# 服务端口
PORT=3000

# 运行环境 (development | production | test)
NODE_ENV=development

# API 认证密钥（逗号分隔的多个密钥）
# 如果未设置，认证将自动跳过（开发模式）
# 生产环境强烈建议设置此变量保护写入端点
SAOHUA_API_KEYS=your-secret-api-key-here,another-key-if-needed

# 示例：
# SAOHUA_API_KEYS=my-production-key-12345
# SAOHUA_API_KEYS=key1,key2,key3
